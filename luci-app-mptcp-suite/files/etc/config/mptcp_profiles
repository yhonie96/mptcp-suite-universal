
config profile 'main'
	option name 'Utama'
	option enabled '1'
	option config '/etc/xray/config.json'
	option service 'xray'
	option outbound_tag 'vless'
	option freedom_tag 'freedom'
	option local_port '12345'
	option vps_port '3443'
	option limit_label 'Tanpa limit'

config profile 'limit5'
	option name '5 Mbps'
	option enabled '1'
	option config '/etc/xray-5mbps/config.json'
	option service 'xray-5mbps'
	option outbound_tag 'vless-5mbps'
	option freedom_tag 'freedom-5mbps'
	option local_port '12346'
	option vps_port '3444'
	option limit_label '5 Mbps'
