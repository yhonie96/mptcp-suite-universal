#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c \
        '[ -e /etc/mptcp-suite/paused ] && exit 0; sleep 30; [ -e /etc/mptcp-suite/paused ] && exit 0; /usr/sbin/bsbf-endpoint-repair'
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
