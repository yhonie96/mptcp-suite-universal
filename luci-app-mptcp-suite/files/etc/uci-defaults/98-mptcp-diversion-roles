#!/bin/sh
[ "$(uci -q get mptcp_profiles.main)" = profile ] && [ -z "$(uci -q get mptcp_profiles.main.diversion_role)" ] && uci set mptcp_profiles.main.diversion_role='main'
[ "$(uci -q get mptcp_profiles.limit5)" = profile ] && [ -z "$(uci -q get mptcp_profiles.limit5.diversion_role)" ] && uci set mptcp_profiles.limit5.diversion_role='limited'
uci commit mptcp_profiles
exit 0
