#!/bin/sh
set -eu
OUT="${1:-}"; UCI="${MPTCP_UCI_BIN:-uci}"
[ -n "$OUT" ] || { echo ERROR=missing_output; exit 2; }
sections(){ "$UCI" -q show mptcp_profiles | awk -F'[.=]' '$0~/^mptcp_profiles\.[^.]+=profile$/{print $2}'; }
get(){ "$UCI" -q get "mptcp_profiles.$1.$2"; }
rget(){ "$UCI" -q get "mptcp_suite.routing.$1" 2>/dev/null || true; }
ipv4(){ echo "$1" | awk -F. 'NF==4{for(i=1;i<=4;i++)if($i!~/^[0-9]+$/||$i<0||$i>255)exit 1;exit 0}{exit 1}'; }
port(){ case "$1" in ""|*[!0-9]*) return 1;; esac; [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]; }
mark_ok(){ printf '%s\n' "$1" | grep -Eq '^0x[0-9A-Fa-f]{1,8}$'; }
MAIN_ID=; LIMIT_ID=; SERVER=
for ID in $(sections); do
 [ "$(get "$ID" enabled 2>/dev/null || true)" = 1 ] || continue
 ROLE="$(get "$ID" diversion_role 2>/dev/null || true)"
 case "$ROLE" in
  main) [ -z "$MAIN_ID" ] || { echo ERROR=duplicate_main_role; exit 3; }; MAIN_ID="$ID" ;;
  limited) [ -z "$LIMIT_ID" ] || { echo ERROR=duplicate_limited_role; exit 4; }; LIMIT_ID="$ID" ;;
  ""|none) ;;
  *) echo ERROR=invalid_role; exit 5 ;;
 esac
done
[ -n "$MAIN_ID" ] || { echo ERROR=main_role_missing; exit 6; }
SERVER="$(get "$MAIN_ID" server)"; MAIN="$(get "$MAIN_ID" local_port)"
ipv4 "$SERVER" || { echo ERROR=invalid_server; exit 7; }; port "$MAIN" || { echo ERROR=invalid_main_port; exit 8; }
LIMIT=
if [ -n "$LIMIT_ID" ]; then
 LS="$(get "$LIMIT_ID" server)"; [ "$LS" = "$SERVER" ] || { echo ERROR=server_mismatch; exit 9; }
 LIMIT="$(get "$LIMIT_ID" local_port)"; port "$LIMIT" || { echo ERROR=invalid_limited_port; exit 10; }
 [ "$LIMIT" != "$MAIN" ] || { echo ERROR=duplicate_local_port; exit 11; }
fi
TM="0x00000001"; BM=""; PM=""
if [ "$(rget allocated)" = 1 ]; then
 C_TM="$(rget tproxy_mark)"; mark_ok "$C_TM" && TM="$C_TM"
 C_BM="$(rget bypass_mark)"; mark_ok "$C_BM" && BM="$C_BM"
 C_PM="$(rget policy_mark)"; mark_ok "$C_PM" && PM="$C_PM"
fi
TMP="$OUT.tmp.$$"; trap 'rm -f "$TMP"' EXIT INT TERM
cat >"$TMP" <<NFT
# Generated by MPTCP Suite from validated profile roles.
destroy table ip mptcp_tproxy
table ip mptcp_tproxy {
 set byp4 { typeof ip daddr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, $SERVER, 224.0.0.0/4, 240.0.0.0/4 } }
 set limited_clients { type ipv4_addr; }
 chain prerouting_mangle {
  type filter hook prerouting priority mangle; policy accept;
  ip daddr { 74.125.68.94, 64.233.170.100-64.233.170.113, 64.233.170.138-64.233.170.139 } return comment "Android-connectivity"
  ip daddr @byp4 return
NFT
[ -z "$BM" ] || echo "  meta mark $BM return" >>"$TMP"
[ -z "$PM" ] || echo "  meta mark $PM return" >>"$TMP"
if [ -n "$LIMIT" ]; then cat >>"$TMP" <<NFT
  ip saddr @limited_clients fib daddr type != local meta l4proto { tcp, udp } counter tproxy ip to 127.0.0.1:$LIMIT meta mark set $TM return comment "LIMITED-PROFILE"
NFT
fi
cat >>"$TMP" <<NFT
  fib daddr type != local meta l4proto { tcp, udp } tproxy ip to 127.0.0.1:$MAIN meta mark set $TM
 }
 chain output_mangle {
  ip daddr 1.1.1.1 tcp dport 53 return
  type route hook output priority mangle; policy accept;
  meta mark 0x00000002 return
NFT
[ -z "$BM" ] || echo "  meta mark $BM return" >>"$TMP"
[ -z "$PM" ] || echo "  meta mark $PM return" >>"$TMP"
cat >>"$TMP" <<NFT
  oifname != "lo" ip daddr { 74.125.68.94, 64.233.170.100-64.233.170.113, 64.233.170.138-64.233.170.139 } return comment "Android-connectivity"
  ip daddr @byp4 return
  oifname != "lo" meta l4proto { tcp, udp } meta mark set $TM
 }
}
NFT
mv "$TMP" "$OUT"; trap - EXIT INT TERM
echo TPROXY_NFT_GENERATE_OK
