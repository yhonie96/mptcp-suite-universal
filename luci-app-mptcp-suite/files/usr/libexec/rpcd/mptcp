#!/bin/sh
. /usr/share/libubox/jshn.sh

DIR=/etc/mptcp-suite
PAUSED=$DIR/paused
MANIFEST=$DIR/tunnel-profiles.tsv
PROFILE_LIST=/usr/sbin/mptcp-profile-list
PROFILE_BACKUP=/usr/sbin/mptcp-profile-backup
PROFILE_RESTART=/usr/sbin/mptcp-profile-restart

reply() {
 json_init
 json_add_boolean ok "$1"
 json_add_string message "$2"
 json_dump
}

enable_service() {
 /etc/init.d/"$1" enable >/dev/null 2>&1 || true
}

disable_service() {
 /etc/init.d/"$1" disable >/dev/null 2>&1 || true
}

cleanup_staged() {
 [ -s "$MANIFEST" ] || return 0
 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  rm -f "$cfg.direct.json" "$cfg.restore.json"
 done <"$MANIFEST"
}

restore_profiles() {
 [ -s "$MANIFEST" ] || return 1
 cleanup_staged

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  [ -s "$snap" ] || { cleanup_staged; return 1; }
  cp -p "$snap" "$cfg.restore.json" || { cleanup_staged; return 1; }
  xray run -test -c "$cfg.restore.json" >/tmp/xray-tunnel-test.log 2>&1 ||
   { cleanup_staged; return 1; }
 done <"$MANIFEST"

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  mv "$cfg.restore.json" "$cfg" || { cleanup_staged; return 1; }
  enable_service "$svc"
 done <"$MANIFEST"

 cleanup_staged
}

direct_mode() {
 mkdir -p "$DIR"
 if [ "${1:-}" != reuse ]; then
  "$PROFILE_BACKUP" >/tmp/mptcp-profile-backup.log 2>&1 || return 1
 fi
 [ -s "$MANIFEST" ] || return 1
 cleanup_staged

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  source="$cfg"
  [ "${1:-}" = reuse ] && source="$snap"
  [ -s "$source" ] || { cleanup_staged; return 1; }
  ucode "$DIR/make-direct.uc" "$source" "$cfg.direct.json" "$vt" "$ft" ||
   { cleanup_staged; return 1; }
  xray run -test -c "$cfg.direct.json" >/tmp/xray-direct-test.log 2>&1 ||
   { cleanup_staged; return 1; }
 done <"$MANIFEST"

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  mv "$cfg.direct.json" "$cfg" || {
   restore_profiles >/dev/null 2>&1 || true
   return 1
  }
  enable_service "$svc"
 done <"$MANIFEST"

 touch "$PAUSED"
 for svc in bsbf-mptcp bsbf-endpoint-repair mptcp-autoreconnect; do
  disable_service "$svc"
 done

 /etc/init.d/mptcp-autoreconnect stop >/dev/null 2>&1 || true
 /etc/init.d/bsbf-endpoint-repair stop >/dev/null 2>&1 || true
 /etc/init.d/bsbf-mptcp stop >/dev/null 2>&1 || true
 ip mptcp endpoint flush >/dev/null 2>&1 || true

 if ! nft -f /usr/share/bsbf/bsbf_bonding.nft ||
    ! "$PROFILE_RESTART" >/tmp/mptcp-profile-restart.log 2>&1 ||
    ! curl -4 -sS --max-time 10 -o /dev/null \
      https://connectivitycheck.gstatic.com/generate_204; then
  restore_profiles >/dev/null 2>&1 || true
  "$PROFILE_RESTART" >/dev/null 2>&1 || true
  rm -f "$PAUSED"
  return 1
 fi
}

tunnel_mode() {
 restore_profiles || return 1

 for svc in bsbf-bonding-nft bsbf-endpoint-repair bsbf-mptcp \
  mptcp-autoreconnect; do
  enable_service "$svc"
 done

 nft -f /usr/share/bsbf/bsbf_bonding.nft || return 1
 /etc/init.d/bsbf-mptcp restart >/dev/null 2>&1 || true
 "$PROFILE_RESTART" >/tmp/mptcp-profile-restart.log 2>&1 || return 1
 timeout 30 /usr/sbin/mptcp-reconnect \
  >/tmp/mptcp-resume-ui.log 2>&1 || return 1

 code="$(curl -4 -sS --max-time 10 -o /dev/null \
  -w '%{http_code}' \
  https://connectivitycheck.gstatic.com/generate_204)"
 [ "$code" = 204 ] || return 1

 rm -f "$PAUSED"
}

case "$1" in
list)
 echo '{ "status": {}, "reconnect": {}, "pause": {}, "resume": {}, "resume_check": {} }'
;;
call)
 case "$2" in
 status)
  R="$(curl -4 -sS --connect-timeout 5 --max-time 8 \
   -o /dev/null -w '%{http_code} %{time_total}' \
   https://connectivitycheck.gstatic.com/generate_204 2>/dev/null)"
  CODE="${R%% *}"; TIME="${R#* }"
  [ -z "$CODE" ] && CODE=000
  [ "$TIME" = "$R" ] && TIME=0
  EP="$(ip mptcp endpoint show 2>/dev/null | grep -c .)"
  SF="$(ss -Mi 2>/dev/null | grep -o 'subflows_total:[0-9]*' |
   cut -d: -f2 | sort -nr | head -n1)"
  [ -z "$SF" ] && SF=0
  XRAY=1
  COUNT=0
  LIST="/tmp/mptcp-status-profiles-$$"
  "$PROFILE_LIST" >"$LIST" 2>/dev/null || XRAY=0
  while IFS="$(printf '\t')" read -r id cfg svc vt ft; do
   [ -n "$id" ] || continue
   COUNT=$((COUNT+1))
   /etc/init.d/"$svc" status 2>/dev/null |
    grep -qx running || XRAY=0
  done <"$LIST"
  rm -f "$LIST"
  [ "$COUNT" -gt 0 ] || XRAY=0
  STATE=gangguan
  [ "$CODE" = 204 ] && STATE=normal
  [ -e "$PAUSED" ] && STATE=paused

  json_init
  json_add_string tunnel "$STATE"
  json_add_string http "$CODE"
  json_add_string time "$TIME"
  json_add_int endpoint "$EP"
  json_add_int subflow "$SF"
  json_add_boolean xray "$XRAY"
  json_add_int profile_count "$COUNT"
  json_add_string backup normal
  json_add_boolean paused "$([ -e "$PAUSED" ] && echo 1 || echo 0)"
  json_dump
 ;;
 reconnect)
  [ -e "$PAUSED" ] && {
   reply 0 "Mode Direct + GeoSite sedang aktif"
   exit 0
  }
  /usr/sbin/mptcp-reconnect >/tmp/mptcp-reconnect-ui.log 2>&1 &
  reply 1 "Koneksi ulang dimulai"
 ;;
 pause)
  [ -e "$PAUSED" ] && {
   reply 1 "Mode Direct + GeoSite sudah aktif"
   exit 0
  }

  if direct_mode; then
   reply 1 "MPTCP dijeda; Direct + GeoSite aktif"
  else
   restore_profiles >/dev/null 2>&1 || true
   rm -f "$PAUSED"
   for svc in bsbf-mptcp bsbf-endpoint-repair mptcp-autoreconnect; do
    enable_service "$svc"
   done
   nft -f /usr/share/bsbf/bsbf_bonding.nft >/dev/null 2>&1 || true
   "$PROFILE_RESTART" >/dev/null 2>&1 || true
   if timeout 40 /usr/sbin/mptcp-reconnect >/tmp/mptcp-pause-rollback.log 2>&1; then
    reply 0 "Direct gagal; mode tunnel dipulihkan"
   else
    reply 0 "Direct gagal; rollback tunnel belum sehat"
   fi
  fi
 ;;
 resume_check)
  O="$(timeout 15 /usr/sbin/mptcp-resume-safe 2>&1)"
  R=$?
  json_init
  json_add_boolean ok "$([ "$R" = 0 ] && echo 1 || echo 0)"
  json_add_int rc "$R"
  json_add_string message "$O"
  json_dump
 ;;

 resume)
  [ -e "$PAUSED" ] || {
   reply 1 "MPTCP sudah aktif"
   exit 0
  }

  O="$(timeout 15 /usr/sbin/mptcp-resume-safe 2>&1)"
  R=$?
  if [ "$R" -ne 0 ]; then
   reply 0 "Aktivasi dibatalkan: $O"
   exit 0
  fi
  if tunnel_mode; then
   reply 1 "Pengaktifan MPTCP dimulai"
  else
   if direct_mode reuse; then
    reply 0 "Aktivasi gagal; mode Direct dipulihkan"
   else
    reply 0 "Aktivasi dan rollback Direct gagal"
   fi
  fi
 ;;
 *) reply 0 "Metode tidak tersedia" ;;
 esac
;;
esac
