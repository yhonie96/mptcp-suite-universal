#!/bin/sh
. /usr/share/libubox/jshn.sh

DIR="${MPTCP_SUITE_DIR:-/etc/mptcp-suite}"
PAUSED=$DIR/paused
MANIFEST=$DIR/tunnel-profiles.tsv
PROFILE_LIST="${MPTCP_PROFILE_LIST:-/usr/sbin/mptcp-profile-list}"
PROFILE_BACKUP="${MPTCP_PROFILE_BACKUP:-/usr/sbin/mptcp-profile-backup}"
PROFILE_RESTART="${MPTCP_PROFILE_RESTART:-/usr/sbin/mptcp-profile-restart}"
DIRECT_SNAPSHOT="${MPTCP_DIRECT_SNAPSHOT:-/usr/sbin/mptcp-direct-snapshot}"
RESUME_CHECK="${MPTCP_RESUME_CHECK:-/usr/sbin/mptcp-resume-safe}"
ACTIVATE="${MPTCP_ACTIVATE:-/usr/sbin/mptcp-activate}"
ROUTING_CLEAR="${MPTCP_ROUTING_CLEAR:-/usr/libexec/mptcp-suite/routing-managed-clear}"
UCODE="${MPTCP_UCODE_BIN:-ucode}"
XRAY_BIN="${MPTCP_XRAY_BIN:-xray}"
INITD="${MPTCP_INITD_DIR:-/etc/init.d}"
NFT_BIN="${MPTCP_NFT_BIN:-nft}"
IP_BIN="${MPTCP_IP_BIN:-ip}"
CHECK_URL=https://connectivitycheck.gstatic.com/generate_204

reply() {
 json_init
 json_add_boolean ok "$1"
 json_add_string message "$2"
 json_dump
}

enable_service() {
 "$INITD/$1" enable >/dev/null 2>&1 || true
}

disable_service() {
 "$INITD/$1" disable >/dev/null 2>&1 || true
}

check_http(){
 W=0
 while test $W -lt 6; do
  C=$(curl -4 -sS --max-time 3 -o /dev/null -w "%{http_code}" "$CHECK_URL" 2>/dev/null || true)
  test "$C" = 204 && return 0
  W=$((W+1))
  sleep 2
 done
 echo ERROR=direct_http_not_ready
 return 1
}

clear_managed_routing() {
 MPTCP_ROUTING_CLEAR_APPLY=1 "$ROUTING_CLEAR" --apply >/tmp/mptcp-routing-clear.log 2>&1
}

disable_diversion() {
 "$INITD/bsbf-bonding-nft" disable >/dev/null 2>&1 || true
 "$NFT_BIN" delete table ip bsbf_bonding >/dev/null 2>&1 || true
}

cleanup_staged() {
 [ -s "$MANIFEST" ] || return 0
 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  rm -f "$cfg.direct.json" "$cfg.restore.json"
 done <"$MANIFEST"
}

restore_profiles() {
 [ -s "$MANIFEST" ] || return 1
 cleanup_staged

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  [ -s "$snap" ] || { cleanup_staged; return 1; }
  cp -p "$snap" "$cfg.restore.json" || { cleanup_staged; return 1; }
  "$XRAY_BIN" run -test -c "$cfg.restore.json" >/tmp/xray-tunnel-test.log 2>&1 ||
   { cleanup_staged; return 1; }
 done <"$MANIFEST"

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  mv "$cfg.restore.json" "$cfg" || { cleanup_staged; return 1; }
  enable_service "$svc"
 done <"$MANIFEST"

 cleanup_staged
}

direct_mode() {
 mkdir -p "$DIR"
 if [ "${1:-}" != reuse ]; then
  "$PROFILE_BACKUP" >/tmp/mptcp-profile-backup.log 2>&1 || return 1
 fi
 [ -s "$MANIFEST" ] || return 1
 cleanup_staged

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  source="$cfg"
  [ "${1:-}" = reuse ] && source="$snap"
  [ -s "$source" ] || { cleanup_staged; return 1; }
  "$UCODE" "$DIR/make-direct.uc" "$source" "$cfg.direct.json" "$vt" "$ft" ||
   { cleanup_staged; return 1; }
  "$XRAY_BIN" run -test -c "$cfg.direct.json" >/tmp/xray-direct-test.log 2>&1 ||
   { cleanup_staged; return 1; }
 done <"$MANIFEST"

 while IFS="$(printf '\t')" read -r id cfg svc vt ft snap; do
  [ -n "$id" ] || continue
  mv "$cfg.direct.json" "$cfg" || {
   restore_profiles >/dev/null 2>&1 || true
   return 1
  }
  enable_service "$svc"
 done <"$MANIFEST"

 touch "$PAUSED"
 for svc in bsbf-mptcp bsbf-endpoint-repair mptcp-autoreconnect; do
  disable_service "$svc"
 done

 "$INITD/mptcp-autoreconnect" stop >/dev/null 2>&1 || true
 "$INITD/bsbf-endpoint-repair" stop >/dev/null 2>&1 || true
 "$INITD/bsbf-mptcp" stop >/dev/null 2>&1 || true
 "$IP_BIN" mptcp endpoint flush >/dev/null 2>&1 || true

 disable_diversion
 if ! clear_managed_routing; then
  touch "$PAUSED"
  return 1
 fi
 if ! "$PROFILE_RESTART" >/tmp/mptcp-profile-restart.log 2>&1; then
  touch "$PAUSED"
  return 1
 fi

 # Pemeriksaan internet hanya penasihat. Kegagalannya (mis. jabat
 # tangan TLS ke endpoint pemeriksa terputus sesaat di jalur Direct)
 # tidak boleh membatalkan jeda yang diminta pengguna; rollback
 # hanya untuk kegagalan lokal (nft/restart profil) di atas.
 # Kesehatan internet tetap terlihat lewat metode status.
 check_http >/dev/null 2>&1 ||
  logger -t mptcp-pause "direct_http_not_ready; jeda tetap dipertahankan"
}

tunnel_mode() {
 disable_diversion
 echo ERROR=transparent_diversion_unsafe
 return 1
}

case "$1" in
list)
 echo '{ "status": {}, "reconnect": {}, "pause": {}, "resume": {}, "resume_check": {} }'
;;
call)
 case "$2" in
 status)
  R="$(curl -4 -sS --connect-timeout 5 --max-time 8 \
   -o /dev/null -w '%{http_code} %{time_total}' \
   https://connectivitycheck.gstatic.com/generate_204 2>/dev/null)"
  CODE="${R%% *}"; TIME="${R#* }"
  [ -z "$CODE" ] && CODE=000
  [ "$TIME" = "$R" ] && TIME=0
  EP="$(ip mptcp endpoint show 2>/dev/null | grep -c .)"
  SF="$(ss -Mi 2>/dev/null | grep -o 'subflows_total:[0-9]*' |
   cut -d: -f2 | sort -nr | head -n1)"
  [ -z "$SF" ] && SF=0
  XRAY=1
  COUNT=0
  LIST="/tmp/mptcp-status-profiles-$$"
  "$PROFILE_LIST" >"$LIST" 2>/dev/null || XRAY=0
  while IFS="$(printf '\t')" read -r id cfg svc vt ft; do
   [ -n "$id" ] || continue
   COUNT=$((COUNT+1))
   /etc/init.d/"$svc" status 2>/dev/null |
    grep -qx running || XRAY=0
  done <"$LIST"
  rm -f "$LIST"
  [ "$COUNT" -gt 0 ] || XRAY=0
  STATE=gangguan
  [ "$CODE" = 204 ] && STATE=normal
  [ -e "$PAUSED" ] && STATE=paused

  json_init
  json_add_string tunnel "$STATE"
  json_add_string http "$CODE"
  json_add_string time "$TIME"
  json_add_int endpoint "$EP"
  json_add_int subflow "$SF"
  json_add_boolean xray "$XRAY"
  json_add_int profile_count "$COUNT"
  json_add_string backup normal
  json_add_boolean paused "$([ -e "$PAUSED" ] && echo 1 || echo 0)"
  json_dump
 ;;
 reconnect)
  [ -e "$PAUSED" ] && {
   reply 0 "Mode Direct sedang aktif"
   exit 0
  }
  /usr/sbin/mptcp-reconnect >/tmp/mptcp-reconnect-ui.log 2>&1 &
  reply 1 "Koneksi ulang dimulai"
 ;;
 pause)
  [ -e "$PAUSED" ] && {
   if clear_managed_routing; then
    reply 1 "Mode Direct sudah aktif; routing MPTCP dibersihkan"
   else
    reply 0 "Mode Direct aktif, tetapi pembersihan routing gagal"
   fi
   exit 0
  }

  if direct_mode; then
   if "$DIRECT_SNAPSHOT" --apply >/tmp/mptcp-direct-snapshot.log 2>&1; then
    reply 1 "MPTCP dijeda; Direct aktif"
   else
    reply 0 "Direct aktif, tetapi snapshot rollback gagal"
   fi
  else
   disable_diversion
   touch "$PAUSED"
   for svc in bsbf-mptcp bsbf-endpoint-repair mptcp-autoreconnect; do
    disable_service "$svc"
    /etc/init.d/"$svc" stop >/dev/null 2>&1 || true
   done
   "$IP_BIN" mptcp endpoint flush >/dev/null 2>&1 || true
   reply 0 "Direct gagal disiapkan; mode Direct darurat dipertahankan"

  fi
 ;;
 resume_check)
  if "$RESUME_CHECK" >/tmp/mptcp-resume-check.log 2>&1; then
   reply 1 "Aktivasi siap"
  else
   reply 0 "Precheck aktivasi gagal"
  fi
 ;;
 resume)
  if "$ACTIVATE" --apply >/tmp/mptcp-activate.log 2>&1; then
   reply 1 "MPTCP aktif"
  else
   touch "$PAUSED"
   reply 0 "Aktivasi gagal; Direct dipertahankan"
  fi
 ;;

 *) reply 0 "Metode tidak tersedia" ;;
 esac
;;
esac
