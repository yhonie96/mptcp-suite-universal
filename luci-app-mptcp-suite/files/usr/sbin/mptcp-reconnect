#!/bin/sh
# Jangan pernah membangun ulang tunnel saat pengguna menjeda MPTCP.
# Pengecualian: resume resmi dari rpcd (MPTCP_RESUME=1) yang memang
# bertugas mengakhiri jeda; file penanda jeda baru dihapus rpcd
# setelah tunnel terbukti sehat.
if [ -e /etc/mptcp-suite/paused ] && [ -z "${MPTCP_RESUME:-}" ]; then
 logger -t mptcp-reconnect "status jeda; reconnect dilewati"
 exit 0
fi
LOCK=/tmp/mptcp-reconnect.lock
if ! mkdir "$LOCK" 2>/dev/null; then exit 0; fi
trap 'rmdir "$LOCK"' EXIT INT TERM
TAG=mptcp-reconnect
logger -t "$TAG" "Memulai koneksi ulang aman"

for DEV in $(ip -4 route show default | awk "{print $5}" | sort -u); do
 IFACE="$(ubus list "network.interface.*" | sed "s/network.interface.//" | while read I; do
  [ "$(ifstatus "$I" 2>/dev/null | jsonfilter -e "@.l3_device")" = "$DEV" ] && { echo "$I"; break; }
 done)"
 [ -n "$IFACE" ] && ubus call "network.interface.$IFACE" up >/dev/null 2>&1
done

/etc/init.d/bsbf-mptcp stop
rm -f /run/bsbf-mptcp-supported /run/bsbf-mptcp-not-supported /run/bsbf-mptcp-no-connectivity
touch /run/bsbf-mptcp-supported /run/bsbf-mptcp-not-supported /run/bsbf-mptcp-no-connectivity
/etc/init.d/bsbf-mptcp start

ip rule show | grep -q 'fwmark 0x1 lookup 10000' ||
 ip rule add pref 100 fwmark 0x1 lookup 10000
ip route replace local 0.0.0.0/0 dev lo table 10000

sleep 12
/usr/sbin/mptcp-profile-restart || exit 1
sleep 3

N="$(ip mptcp endpoint show | grep -c .)"
if [ "$N" -ge 1 ]; then
 logger -t "$TAG" "Berhasil, endpoint=$N"
 exit 0
fi
logger -t "$TAG" "Gagal, endpoint=$N"
exit 1
