#!/bin/sh
set -eu
DIR=/etc/mptcp-suite
M="$DIR/tunnel-main.json"
L="$DIR/tunnel-5mbps.json"
MODE="$(cat /etc/bsbf/bsbf-mptcp-mode 2>/dev/null || echo combine)"
PRIMARY="$(cat /etc/bsbf/bsbf-mptcp-primary 2>/dev/null || true)"
BACKUPS="$(cat /etc/bsbf/bsbf-mptcp-subflow-backup 2>/dev/null || true)"

test -s "$M" && test -s "$L" || { echo ERROR=missing_tunnel_backup; exit 1; }
xray run -test -c "$M" >/dev/null
xray run -test -c "$L" >/dev/null

case "$MODE" in
 primary)
  [ -n "$PRIMARY" ] || { echo ERROR=missing_primary; exit 1; }
  DEVICES="$PRIMARY $BACKUPS"
 ;;
 combine)
  DEVICES="$(ip -4 route show default | awk '{print $5}' | sort -u | tr '\n' ' ')"
 ;;
 *)
  echo "ERROR=invalid_mode:$MODE"
  exit 1
 ;;
esac

[ -n "$DEVICES" ] || { echo ERROR=no_active_paths; exit 1; }

for D in $DEVICES; do
 [ -e "/sys/class/net/$D" ] || { echo "ERROR=missing_device:$D"; exit 1; }
 ping -I "$D" -c 1 -W 2 1.1.1.1 >/dev/null ||
  { echo "ERROR=no_internet:$D"; exit 1; }
done

echo "RESUME_PRECHECK_OK mode=$MODE devices=$DEVICES"
