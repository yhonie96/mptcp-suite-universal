
config core 'core'
	option version '0.1'
	option lan_network 'lan'
	option auto_detect '1'

config routing 'routing'
	option allocated '0'

config xray 'xray'
	option enabled '1'

config modules 'modules'
	option xray '1'
	option traffic_policy '1'
	option netcontrol '0'
	option cake '0'


# Contoh nonaktif untuk UI mendatang.
config traffic_rule 'example_device'
option enabled '0'
option policy 'secondary'
list src_ip '192.0.2.100'
list src_mac '02:00:00:00:00:01'

config failover 'failover'
option enabled '0'
option primary_table '102'
option failure_threshold '3'
option recovery_threshold '3'
option check_url 'https://connectivitycheck.gstatic.com/generate_204'
