#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=10
start_service(){
 enabled="$(uci -q get mptcp_suite.failover.enabled)"
 [ "$enabled" = 1 ] || return 0
 [ -e /etc/mptcp-suite/paused ] || return 0
 procd_open_instance
 procd_set_param command /usr/libexec/mptcp-suite/paused-failover-monitor --run
 procd_set_param respawn 5 10 0
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
stop_service(){ /usr/libexec/mptcp-suite/paused-failover-monitor --restore >/dev/null 2>&1 || return 1; }
service_triggers(){ procd_add_reload_trigger mptcp_suite network; }
