#!/bin/sh
set -eu
CFG=mptcp_suite.failover
[ "$(uci -q get "$CFG")" = failover ] || exit 0
changed=0
set_default(){
 key="$1"; value="$2"
 [ -n "$(uci -q get "$CFG.$key")" ] && return 0
 uci set "$CFG.$key=$value"
 changed=1
}
set_default interval 10
set_default probe_ip 1.1.1.1
[ "$changed" -eq 0 ] || uci commit mptcp_suite
exit 0
