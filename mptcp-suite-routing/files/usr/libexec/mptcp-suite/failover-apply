#!/bin/sh
set -eu
ACTION="${1:-}"
PRIMARY_DEV="${2:-}"
PRIMARY_GW="${3:-}"
PRIMARY_METRIC="${4:-}"
SECONDARY_DEV="${5:-}"
SECONDARY_GW="${6:-}"
SECONDARY_METRIC="${7:-}"
TABLE="${8:-}"

number(){ case "$1" in ""|*[!0-9]*) return 1;; esac; }
[ -n "$PRIMARY_DEV" ] && [ -n "$PRIMARY_GW" ] &&
[ -n "$SECONDARY_DEV" ] && [ -n "$SECONDARY_GW" ] &&
number "$PRIMARY_METRIC" && number "$SECONDARY_METRIC" &&
number "$TABLE" || { echo "ERROR=invalid_parameters"; exit 1; }

case "$ACTION" in
 FAILOVER)
  echo "ip route del default via $PRIMARY_GW dev $PRIMARY_DEV metric $PRIMARY_METRIC"
  echo "ip route del default via $PRIMARY_GW dev $PRIMARY_DEV table $TABLE metric $PRIMARY_METRIC"
  echo "ip route replace default via $SECONDARY_GW dev $SECONDARY_DEV table $TABLE metric $SECONDARY_METRIC"
 ;;
 RESTORE)
  echo "ip route replace default via $PRIMARY_GW dev $PRIMARY_DEV metric $PRIMARY_METRIC"
  echo "ip route del default via $SECONDARY_GW dev $SECONDARY_DEV table $TABLE metric $SECONDARY_METRIC"
  echo "ip route replace default via $PRIMARY_GW dev $PRIMARY_DEV table $TABLE metric $PRIMARY_METRIC"
 ;;
 KEEP) echo "NO_CHANGE" ;;
 *) echo "ERROR=invalid_action"; exit 1 ;;
esac
