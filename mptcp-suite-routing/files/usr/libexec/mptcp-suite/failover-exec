#!/bin/sh
set -eu
MODE="${1:---dry-run}"
shift || true
APPLY="${MPTCP_FAILOVER_APPLY_BIN:-/usr/libexec/mptcp-suite/failover-apply}"
RESTORE="${MPTCP_FAILOVER_RESTORE_BIN:-/usr/libexec/mptcp-suite/failover-restore}"
LOCK=/tmp/mptcp-failover.lock
SNAP=/tmp/mptcp-failover.routes

exec 9>"$LOCK"
flock -n 9 || { echo "ERROR=locked"; exit 2; }

snapshot(){
 {
  echo "=== MAIN ==="
  ip route show default
  echo "=== TABLE ==="
  ip route show table "${8:-102}"
 } >"$SNAP"
}

run_actions(){
 CMDS="$("$APPLY" "$@")" || return 1
 OLDIFS="$IFS"; IFS='
'
 for CMD in $CMDS; do
  case "$CMD" in
   NO_CHANGE) ;;
   "ip route del default via "*|"ip route replace default via "*)
    IFS="$OLDIFS"; set -- $CMD; IFS='
'
    "$@" || return 1
   ;;
   *) echo "ERROR=unsafe_command"; return 5 ;;
  esac
 done
 IFS="$OLDIFS"
}

case "$MODE" in
 --dry-run) snapshot "$@"; exec "$APPLY" "$@" ;;
 --apply)
  [ "${MPTCP_FAILOVER_APPLY:-0}" = 1 ] || { echo "ERROR=apply_locked"; exit 4; }
  snapshot "$@"
  ACTION="${1:-}"
  case "$ACTION" in
   FAILOVER) TARGET="${5:-}"; ROLLBACK=RESTORE ;;
   RESTORE) TARGET="${2:-}"; ROLLBACK=FAILOVER ;;
   KEEP) TARGET="${2:-}"; ROLLBACK=KEEP ;;
   *) echo "ERROR=invalid_action"; exit 1 ;;
  esac
  run_actions "$@" || exit $?
  ROUTE="$(ip route get 8.8.8.8 mark 0x2 2>/dev/null)" || ROUTE=
  ROUTE_OK=0
  echo "$ROUTE" | grep -Fq "dev $TARGET table ${8:-102}" && ROUTE_OK=1
  CODE="$(curl --interface "$TARGET" -4 -sS --connect-timeout 3 --max-time 8 -o /dev/null -w "%{http_code}" https://connectivitycheck.gstatic.com/generate_204)" || CODE=000
  [ "$ROUTE_OK" = 1 ] && [ "$CODE" = 204 ] || {
   run_actions "$ROLLBACK" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}" "${8:-}" || {
    echo "ERROR=rollback_action_failed"; exit 6
   }
   "$RESTORE" "$SNAP" "${8:-}" >/dev/null || {
    echo "ERROR=snapshot_restore_failed"; exit 7
   }
   echo "ERROR=validation_failed_snapshot_restored"; exit 3
  }
  echo "APPLY_OK=$ACTION"
 ;;
 *) echo "ERROR=invalid_mode"; exit 1 ;;
esac
