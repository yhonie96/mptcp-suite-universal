#!/bin/sh
set -eu
MODE="${1:---dry-run}"
shift || true
APPLY="${MPTCP_FAILOVER_APPLY_BIN:-/usr/libexec/mptcp-suite/failover-apply}"
LOCK=/tmp/mptcp-failover.lock
SNAP=/tmp/mptcp-failover.routes

exec 9>"$LOCK"
flock -n 9 || { echo "ERROR=locked"; exit 2; }

snapshot(){
 {
  echo "=== MAIN ==="
  ip route show default
  echo "=== TABLE ==="
  ip route show table "${8:-102}"
 } >"$SNAP"
}

case "$MODE" in
 --dry-run)
  snapshot "$@"
  exec "$APPLY" "$@"
 ;;
 --apply)
  [ "${MPTCP_FAILOVER_APPLY:-0}" = 1 ] || { echo "ERROR=apply_locked"; exit 4; }
  snapshot "$@"
  ACTION="${1:-}"
  case "$ACTION" in
   FAILOVER) TARGET="${5:-}"; ROLLBACK=RESTORE ;;
   RESTORE) TARGET="${2:-}"; ROLLBACK=FAILOVER ;;
   KEEP) TARGET="${2:-}"; ROLLBACK=KEEP ;;
   *) echo "ERROR=invalid_action"; exit 1 ;;
  esac
  CMDS="$("$APPLY" "$@")"
  printf "%s
" "$CMDS" | while IFS= read -r CMD; do
   [ "$CMD" = "NO_CHANGE" ] || sh -c "$CMD"
  done
  CODE="$(curl --interface "$TARGET" -4 -sS --connect-timeout 3 --max-time 8 -o /dev/null -w "%{http_code}" https://connectivitycheck.gstatic.com/generate_204)"
  if [ "$CODE" != 204 ]; then
   "$APPLY" "$ROLLBACK" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}" "${8:-}" |
    while IFS= read -r CMD; do
     [ "$CMD" = "NO_CHANGE" ] || sh -c "$CMD"
    done
   echo "ERROR=validation_failed_rollback_done"
   exit 3
  fi
  echo "APPLY_OK=$ACTION"
 ;;
 *)
  echo "ERROR=invalid_mode"
  exit 1
 ;;
esac
