#!/bin/sh
set -eu
UCI="${MPTCP_UCI_BIN:-uci}"; PING="${MPTCP_PING_BIN:-ping}"; IP="${MPTCP_IP_BIN:-ip}"; CURL="${MPTCP_CURL_BIN:-curl}"
ROUTE="${MPTCP_PAUSED_FAILOVER_ROUTE_BIN:-/usr/libexec/mptcp-suite/paused-failover-route}"
POLICY="${MPTCP_PAUSED_POLICY_FAILOVER_BIN:-/usr/libexec/mptcp-suite/paused-policy-failover}"
POLICY_STATE="${MPTCP_PAUSED_POLICY_STATE:-/tmp/mptcp-paused-policy.state}"
POLICY_TABLE="${MPTCP_POLICY_TABLE:-101}"
XRAY_DNS_SVC="${MPTCP_XRAY_DNS_SERVICE:-/etc/init.d/xray-dns}"
DNSMASQ_SVC="${MPTCP_DNSMASQ_SERVICE:-/etc/init.d/dnsmasq}"
PAUSED="${MPTCP_PAUSED_FILE:-/etc/mptcp-suite/paused}"; STATE="${MPTCP_PAUSED_FAILOVER_STATE:-/tmp/mptcp-paused-failover.state}"
ONCE="${MPTCP_PAUSED_FAILOVER_ONCE:-0}"; COMMAND="${1:---run}"
LOCK="${MPTCP_PAUSED_FAILOVER_MONITOR_LOCK:-/tmp/mptcp-paused-failover-monitor.lock}"
get(){ "$UCI" -q get "$1" 2>/dev/null || true; }
log(){ logger -t mptcp-paused-failover "$*" 2>/dev/null || true; echo "$*"; }
refresh_dns(){
 [ -x "$XRAY_DNS_SVC" ] && "$XRAY_DNS_SVC" restart >/dev/null 2>&1 || true
 [ -x "$DNSMASQ_SVC" ] && "$DNSMASQ_SVC" restart >/dev/null 2>&1 || true
 log DNS_REFRESH=ok
}
probe(){
 CODE="$("$CURL" --interface "$1" -4 -sS --connect-timeout 3 --max-time 8 -o /dev/null -w "%{http_code}" "$URL" 2>/dev/null || true)"
 [ "$CODE" = 204 ] && return 0
 "$PING" -c 1 -W 2 -I "$1" "$PROBE_IP_PRIMARY" >/dev/null 2>&1 && return 0
 "$PING" -c 1 -W 2 -I "$1" "$PROBE_IP_SECONDARY" >/dev/null 2>&1
}
load_config(){
 PIF="$(get mptcp_suite.failover.primary_interface)"; PIF="${PIF:-$(get mptcp_suite.core.primary_wan)}"
 SIF="$(get mptcp_suite.failover.secondary_interface)"; SIF="${SIF:-$(get mptcp_suite.core.secondary_wan)}"
 PDEV="$(get network.$PIF.device)"; PGW="$(get network.$PIF.gateway)"; PMET="$(get network.$PIF.metric)"
 SDEV="$(get network.$SIF.device)"; SGW="$(get network.$SIF.gateway)"; SMET="$(get network.$SIF.metric)"
 URL="$(get mptcp_suite.failover.check_url)"; PROBE_IP_PRIMARY="$(get mptcp_suite.failover.probe_ip_primary)"; PROBE_IP_PRIMARY="${PROBE_IP_PRIMARY:-1.1.1.1}"; PROBE_IP_SECONDARY="$(get mptcp_suite.failover.probe_ip_secondary)"; PROBE_IP_SECONDARY="${PROBE_IP_SECONDARY:-8.8.8.8}"; FAIL="$(get mptcp_suite.failover.failure_threshold)"; REC="$(get mptcp_suite.failover.recovery_threshold)"
 INTERVAL="$(get mptcp_suite.failover.interval)"; INTERVAL="${INTERVAL:-10}"
 case "$FAIL:$REC:$INTERVAL:$PMET:$SMET" in *[!0-9:]*) log ERROR=invalid_config; return 1;; esac
 [ "$FAIL" -gt 0 ] && [ "$REC" -gt 0 ] && [ "$INTERVAL" -gt 0 ] || { log ERROR=invalid_config; return 1; }
 [ -n "$PDEV" ] && [ -n "$PGW" ] && [ -n "$SDEV" ] && [ -n "$SGW" ] && [ -n "$URL" ] && [ -n "$PROBE_IP_PRIMARY" ] && [ -n "$PROBE_IP_SECONDARY" ] || { log ERROR=invalid_config; return 1; }
}
actual_mode(){
 R="$("$IP" route get 8.8.8.8 2>/dev/null || true)"
 case "$R" in *"via $PGW dev $PDEV"*) echo primary;; *"via $SGW dev $SDEV"*) echo secondary;; *) echo unknown;; esac
}
actual_policy_mode(){
 PR="$("$IP" route show table "$POLICY_TABLE" 2>/dev/null || true)"
 case "$PR" in
  *"default via $SGW dev $SDEV"*) echo secondary;;
  *"default via $PGW dev $PDEV"*) echo primary;;
  *"default "*) echo unknown;;
  *) echo empty;;
 esac
}
read_counts(){
 FC=0; RC=0
 [ -r "$STATE" ] || return 0
 while IFS='=' read -r K V; do
  case "$K:$V" in FC:*[!0-9]*|RC:*[!0-9]*) FC=0; RC=0; return 0;; FC:*) FC="$V";; RC:*) RC="$V";; esac
 done <"$STATE"
}
save(){ T="$STATE.tmp.$$"; printf 'FC=%s\nRC=%s\n' "$FC" "$RC" >"$T"; mv "$T" "$STATE"; }
restore_primary(){
 [ "$(actual_mode)" = secondary ] || { rm -f "$STATE"; return 0; }
 MPTCP_PAUSED_FAILOVER_APPLY=1 "$ROUTE" --apply RESTORE "$PDEV" "$PGW" "$PMET" "$SDEV" "$SGW" "$SMET" "$URL" "$PROBE_IP_PRIMARY" "$PROBE_IP_SECONDARY" || { log ERROR=restore_primary_failed; return 1; }
 rm -f "$STATE"; log STATE=primary; refresh_dns
}

policy_cycle(){
 SFC=0; SRC=0; PMODE=secondary
 [ -r "$POLICY_STATE" ] && . "$POLICY_STATE" 2>/dev/null || true
 ACT_PMODE="$(actual_policy_mode)"
 if [ "$ACT_PMODE" = primary ] || [ "$ACT_PMODE" = secondary ]; then
  PMODE="$ACT_PMODE"
 fi
 POK=0; SOK=0; probe "$PDEV" && POK=1; probe "$SDEV" && SOK=1
 if [ "$ACT_PMODE" = unknown ] || [ "$ACT_PMODE" = empty ]; then
  if [ "$SOK" = 1 ]; then
   if "$POLICY" --secondary >/dev/null 2>&1; then PMODE=secondary; SFC=0; SRC=0; refresh_dns; else log ERROR=policy_secondary_restore; fi
  elif [ "$POK" = 1 ]; then
   if "$POLICY" --primary-fallback >/dev/null 2>&1; then PMODE=primary; SFC=0; SRC=0; refresh_dns; else log ERROR=policy_primary_fallback; fi
  fi
 elif [ "$SOK" = 1 ]; then
  SFC=0
  if [ "$PMODE" = primary ]; then
   SRC=$((SRC+1))
   if [ "$SRC" -ge "$REC" ]; then
    if "$POLICY" --secondary; then PMODE=secondary; SRC=0; refresh_dns; else log ERROR=policy_secondary_restore; fi
   fi
  else
   SRC=0
  fi
 else
  SRC=0
  if [ "$PMODE" = secondary ]; then
   SFC=$((SFC+1))
   if [ "$SFC" -ge "$FAIL" ] && [ "$POK" = 1 ]; then
    if "$POLICY" --primary-fallback; then PMODE=primary; SFC=0; refresh_dns; else log ERROR=policy_primary_fallback; fi
   fi
  else
   SFC=0
  fi
 fi
 T="$POLICY_STATE.tmp.$$"; printf 'SFC=%s\nSRC=%s\nPMODE=%s\n' "$SFC" "$SRC" "$PMODE" >"$T"; mv "$T" "$POLICY_STATE"
}
cycle(){
 load_config || return 1
 if [ ! -e "$PAUSED" ] || [ "$(get mptcp_suite.failover.enabled)" != 1 ]; then restore_primary; echo MONITOR_IDLE; return; fi
 policy_cycle
 MODE="$(actual_mode)"; [ "$MODE" != unknown ] || { log ERROR=route_state_unknown; return 1; }
 read_counts
 if [ "$MODE" = primary ]; then
  RC=0; PREV_FC="$FC"
  if [ "$POK" = 1 ]; then
   FC=0
   [ "$PREV_FC" -gt 0 ] && refresh_dns
  else
   FC=$((FC+1))
  fi
  if [ "$FC" -ge "$FAIL" ]; then
   [ "$SOK" = 1 ] || { log KEEP=both_unhealthy; save; return; }
   MPTCP_PAUSED_FAILOVER_APPLY=1 "$ROUTE" --apply FAILOVER "$PDEV" "$PGW" "$PMET" "$SDEV" "$SGW" "$SMET" "$URL" "$PROBE_IP_PRIMARY" "$PROBE_IP_SECONDARY" || { log ERROR=failover_transaction; save; return 1; }
   FC=0; RC=0; log STATE=secondary; refresh_dns
  fi
 else
  FC=0; if [ "$POK" = 1 ]; then RC=$((RC+1)); else RC=0; fi
  if [ "$RC" -ge "$REC" ]; then
   MPTCP_PAUSED_FAILOVER_APPLY=1 "$ROUTE" --apply RESTORE "$PDEV" "$PGW" "$PMET" "$SDEV" "$SGW" "$SMET" "$URL" "$PROBE_IP_PRIMARY" "$PROBE_IP_SECONDARY" || { log ERROR=restore_transaction; save; return 1; }
   FC=0; RC=0; log STATE=primary; refresh_dns
  fi
 fi
 save
}
case "$COMMAND" in
 --restore) load_config; restore_primary;;
 --run)
  exec 8>"$LOCK"; flock -n 8 || { echo ERROR=locked; exit 0; }
  while :; do
   if [ "$ONCE" = 1 ]; then cycle; exit 0; fi
   cycle || true
   sleep "${INTERVAL:-10}"
  done
 ;;
 *) echo ERROR=invalid_mode; exit 2;;
esac
