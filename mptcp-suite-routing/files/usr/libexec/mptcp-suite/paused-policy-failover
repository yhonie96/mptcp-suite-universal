#!/bin/sh
set -eu
MODE="${1:---dry-run}"
UCI="${MPTCP_UCI_BIN:-uci}"; IP="${MPTCP_IP_BIN:-ip}"; FLOCK="${MPTCP_FLOCK_BIN:-flock}"
TABLE="${MPTCP_POLICY_TABLE:-101}"; MARK="${MPTCP_POLICY_MARK:-0x102}"; PRIORITY="${MPTCP_POLICY_PRIORITY:-99}"
LOCK="${MPTCP_POLICY_LOCK:-/tmp/mptcp-paused-policy.lock}"; SNAP="${MPTCP_POLICY_SNAPSHOT:-/tmp/mptcp-paused-policy.snapshot.$$}"
get(){ "$UCI" -q get "$1"; }
iface(){ local I="$1"; D="$(get network."$I".device)"; G="$(get network."$I".gateway)"; M="$(get network."$I".metric)"; [ -n "$D" ] && [ -n "$G" ] && [ -n "$M" ]; }
load(){ P="$(get mptcp_suite.core.primary_wan)"; S="$(get mptcp_suite.core.secondary_wan)"; iface "$P"; PDEV="$D"; PGW="$G"; PMET="$M"; iface "$S"; SDEV="$D"; SGW="$G"; SMET="$M"; }
snapshot(){ "$IP" route show table "$TABLE" >"$SNAP"; }
parse_route(){
 VIA=; DEV=; METRIC=
 set -- $1
 [ "${1:-}" = default ] || return 1
 shift
 while [ "$#" -gt 0 ]; do
  K="$1"; shift
  case "$K" in
   via) [ "$#" -gt 0 ] || return 1; VIA="$1"; shift ;;
   dev) [ "$#" -gt 0 ] || return 1; DEV="$1"; shift ;;
   metric) [ "$#" -gt 0 ] || return 1; METRIC="$1"; shift ;;
   proto|src|scope) [ "$#" -gt 0 ] || return 1; shift ;;
   onlink|linkdown) ;;
   *) return 1 ;;
  esac
 done
 [ -n "$VIA" ] && [ -n "$DEV" ] && [ -n "$METRIC" ]
}
restore(){
 "$IP" route flush table "$TABLE" || return 1
 while IFS= read -r L; do
  [ -z "$L" ] || { parse_route "$L" && "$IP" route add default via "$VIA" dev "$DEV" table "$TABLE" metric "$METRIC" || return 1; }
 done <"$SNAP"
 "$IP" route flush cache
 [ -n "$("$IP" route show table "$TABLE")" ]
}
safe_secondary(){ "$IP" route flush table "$TABLE" || true; "$IP" route add default via "$SGW" dev "$SDEV" table "$TABLE" metric "$SMET" || true; "$IP" route flush cache || true; }
verify(){
 local EG="$1" ED="$2" EM="$3" OUT
 OUT="$("$IP" route show table "$TABLE")"
 [ "$(printf '%s\n' "$OUT" | grep -c '^default ')" -eq 1 ] || return 1
 parse_route "$(printf '%s\n' "$OUT" | grep '^default ')" || return 1
 [ "$VIA:$DEV:$METRIC" = "$EG:$ED:$EM" ]
}
apply(){ local G="$1" D="$2" M="$3"; snapshot; "$IP" route flush table "$TABLE" || return 1; "$IP" route add default via "$G" dev "$D" table "$TABLE" metric "$M" || { restore || safe_secondary; return 1; }; verify "$G" "$D" "$M" || { restore || safe_secondary; return 1; }; "$IP" rule del priority "$PRIORITY" 2>/dev/null || true; "$IP" rule add priority "$PRIORITY" fwmark "$MARK/0x1ff" lookup "$TABLE" || { restore || safe_secondary; return 1; }; "$IP" route flush cache; }
load || { echo ERROR=invalid_wan_config; exit 2; }
case "$MODE" in --dry-run) echo "PAUSED_POLICY_FAILOVER_DRY_RUN table=$TABLE primary=$PDEV secondary=$SDEV"; exit 0;; --secondary) G="$SGW"; D="$SDEV"; M="$SMET"; OK=SECONDARY;; --primary-fallback) G="$PGW"; D="$PDEV"; M="$PMET"; OK=PRIMARY_FALLBACK;; *) echo ERROR=invalid_mode; exit 4;; esac
[ -e "${MPTCP_PAUSED_FILE:-/etc/mptcp-suite/paused}" ] || { echo ERROR=not_paused; exit 3; }
exec 9>"$LOCK"; "$FLOCK" -n 9 || { echo ERROR=lock_busy; exit 5; }
trap 'rm -f "$SNAP"' EXIT INT TERM
apply "$G" "$D" "$M" || { echo ERROR=transaction_failed; exit 6; }
echo "PAUSED_POLICY_ROUTE_OK=$OK"
