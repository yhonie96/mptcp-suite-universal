#!/bin/sh
set -eu
MODE="${1:---dry-run}"
PLAN="${MPTCP_ROUTING_PLAN_BIN:-/usr/libexec/mptcp-suite/routing-plan}"
RESTORE="${MPTCP_ROUTING_RESTORE_BIN:-/usr/libexec/mptcp-suite/routing-restore}"
PLAN_FILE="${MPTCP_ROUTING_PLAN_FILE:-/tmp/mptcp-routing.plan}"
PAUSED_FILE="${MPTCP_PAUSED_FILE:-/etc/mptcp-suite/paused}"
CFG="${MPTCP_ROUTING_CONFIG:-/etc/config}"
get(){ uci -c "$CFG" -q get "mptcp_suite.routing.$1"; }
LOCK=/tmp/mptcp-routing.lock
SNAP=/tmp/mptcp-routing.snapshot
exec 9>"$LOCK"
flock -n 9 || { echo ERROR=locked; exit 2; }
validate_config(){
 [ -n "$PT" ] && [ -n "$ST" ] && [ -n "$TT" ] || { echo ERROR=incomplete_configuration; return 1; }
 case "$PT:$ST:$TT" in *[!0-9:]*) echo ERROR=incomplete_configuration; return 1;; esac
 [ "$PT" != "$ST" ] && [ "$PT" != "$TT" ] && [ "$ST" != "$TT" ] || { echo ERROR=duplicate_table_id; return 1; }
 [ "$PT" -ge 1 ] && [ "$PT" -le 4294967295 ] && [ "$ST" -ge 1 ] && [ "$ST" -le 4294967295 ] && [ "$TT" -ge 1 ] && [ "$TT" -le 4294967295 ] || { echo ERROR=table_id_range; return 1; }
 [ -n "$BP" ] && [ -n "$PP" ] && [ -n "$TP" ] || { echo ERROR=incomplete_priority; return 1; }
 case "$BP:$PP:$TP" in *[!0-9:]*) echo ERROR=incomplete_priority; return 1;; esac
 [ "$BP" != "$PP" ] && [ "$BP" != "$TP" ] && [ "$PP" != "$TP" ] || { echo ERROR=duplicate_priorities; return 1; }
 [ "$BP" -ge 1 ] && [ "$BP" -le 32765 ] && [ "$PP" -ge 1 ] && [ "$PP" -le 32765 ] && [ "$TP" -ge 1 ] && [ "$TP" -le 32765 ] || { echo ERROR=priority_range; return 1; }
}
generate_plan(){
 rm -f "$PLAN_FILE.tmp"
 "$PLAN" "$CFG" "$PLAN_FILE.tmp" >/dev/null || {
  rm -f "$PLAN_FILE.tmp"; return 1
 }
 [ -s "$PLAN_FILE.tmp" ] || {
  rm -f "$PLAN_FILE.tmp"; return 1
 }
 mv "$PLAN_FILE.tmp" "$PLAN_FILE"
}
run_plan(){
 [ -r "$PLAN_FILE" ] || { echo ERROR=plan_missing; return 1; }
 while IFS= read -r CMD; do
  CMD="${CMD%%#*}"; set -- $CMD
  [ "$#" -gt 0 ] || continue
  OK=0
  [ "$#" -eq 10 ] && [ "$1:$2:$3:$4:$5:$7:$9" = "ip:route:replace:default:via:dev:table" ] && { [ "${10}" = "$PT" ] || [ "${10}" = "$ST" ]; } && OK=1
  [ "$#" -eq 9 ] && [ "$1:$2:$3:$4:$5:$6:$7:$8:$9" = "ip:route:replace:local:0.0.0.0/0:dev:lo:table:$TT" ] && OK=1
  [ "$#" -eq 9 ] && [ "$1:$2:$3:$4:$6:$8" = "ip:rule:add:priority:fwmark:lookup" ] && { [ "$5:$7:$9" = "$BP:$BM:$PT" ] || [ "$5:$7:$9" = "$PP:$PM:$ST" ] || [ "$5:$7:$9" = "$TP:$TM:$TT" ]; } && OK=1
  [ "$OK" = 1 ] || { echo ERROR=unsafe_command; return 2; }
  "$@" || return 1
 done <"$PLAN_FILE"
}
validate_routes(){
 R1="$(ip route get 8.8.8.8 mark "$BM" 2>/dev/null)" || return 1
 R2="$(ip route get 8.8.8.8 mark "$PM" 2>/dev/null)" || return 1
 R3="$(ip route get 8.8.8.8 mark "$TM" 2>/dev/null)" || return 1
 echo "$R1" | grep -Fq "table $PT" || return 1
 echo "$R2" | grep -Fq "table $ST" || return 1
 echo "$R3" | grep -Fq "table $TT" || return 1
}

snapshot(){
 {
  echo TABLE_PRIMARY
  ip route show table "$PT"
  echo TABLE_SECONDARY
  ip route show table "$ST"
  echo TABLE_TPROXY
  ip route show table "$TT"
  echo RULES
  ip rule show | grep -E "^($BP|$PP|$TP):" || true
 } >"$SNAP"
}
restore_snapshot(){
 [ -s "$SNAP" ] || return 1
 ip rule del priority "$BP" 2>/dev/null || true
 ip rule del priority "$PP" 2>/dev/null || true
 ip rule del priority "$TP" 2>/dev/null || true
 ip route flush table "$PT" 2>/dev/null || true
 ip route flush table "$ST" 2>/dev/null || true
 ip route flush table "$TT" 2>/dev/null || true
}
rollback(){ restore_snapshot && "$RESTORE" "$SNAP" "$PT" "$ST" "$TT" "$BP" "$PP" "$TP"; }
apply_transaction(){
 snapshot || return 1
 run_plan || { rollback || return 13; echo ERROR=plan_apply_failed_snapshot_restored; return 11; }
 validate_routes || { rollback || return 13; echo ERROR=validation_failed_snapshot_restored; return 12; }
 echo ROUTING_APPLY_OK
}
case "$MODE" in
 --test-transaction)
  [ "${MPTCP_ROUTING_TEST:-0}" = 1 ] || { echo ERROR=test_locked; exit 9; }
  PT=11001; ST=11002; TT=11003
  BP=98; PP=99; TP=100
  BM=0x4A02; PM=0x4A03; TM=0x4A01
  apply_transaction
 ;;
 --test-plan)
  [ "${MPTCP_ROUTING_TEST:-0}" = 1 ] || { echo ERROR=test_locked; exit 9; }
  PT="${MPTCP_TEST_PT:-11001}"; ST="${MPTCP_TEST_ST:-11002}"; TT="${MPTCP_TEST_TT:-11003}"
  BP="${MPTCP_TEST_BP:-98}"; PP="${MPTCP_TEST_PP:-99}"; TP="${MPTCP_TEST_TP:-100}"
  BM="${MPTCP_TEST_BM:-0x4A02}"; PM="${MPTCP_TEST_PM:-0x4A03}"; TM="${MPTCP_TEST_TM:-0x4A01}"
  run_plan
 ;;
 --dry-run) exec "$PLAN" ;;
 --apply)
  [ ! -e "$PAUSED_FILE" ] || { echo ERROR=paused; exit 3; }
  [ "${MPTCP_ROUTING_APPLY:-0}" = 1 ] || { echo ERROR=apply_locked; exit 4; }
  ALLOCATED="$(get allocated)"
  PT="$(get primary_table)"
  ST="$(get secondary_table)"
  TT="$(get tproxy_table)"
  BP="$(get primary_priority)"
  PP="$(get secondary_priority)"
  TP="$(get tproxy_priority)"
  BM="$(get bypass_mark)"
  PM="$(get policy_mark)"
  TM="$(get tproxy_mark)"
  [ "$ALLOCATED" = 1 ] || { echo ERROR=not_allocated; exit 6; }
  validate_config || exit 7
  generate_plan || { echo ERROR=plan_generation_failed; exit 10; }
  : ERROR=validation_failed_snapshot_restored
  echo ERROR=apply_not_implemented
  exit 8
  snapshot
  run_plan || { rollback; echo ERROR=plan_apply_failed_snapshot_restored; exit 11; }
  validate_routes || { rollback; echo ERROR=validation_failed_snapshot_restored; exit 12; }
  echo ROUTING_APPLY_OK
 ;;
 *) echo ERROR=invalid_mode; exit 1;;
esac
