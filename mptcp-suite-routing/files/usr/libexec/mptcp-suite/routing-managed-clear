#!/bin/sh
set -eu
MODE="${1:---dry-run}"
CFG="${MPTCP_ROUTING_CONFIG_DIR:-/etc/config}"
IP="${MPTCP_ROUTING_IP_BIN:-ip}"
UCI="${MPTCP_ROUTING_UCI_BIN:-uci}"
FLOCK="${MPTCP_ROUTING_FLOCK_BIN:-flock}"
LOCK="${MPTCP_ROUTING_CLEAR_LOCK:-/tmp/mptcp-routing-clear.lock}"
STATE="${MPTCP_ROUTING_CLEAR_STATE:-/tmp/mptcp-routing-clear.state.$$}"
get(){ "$UCI" -c "$CFG" -q get "mptcp_suite.routing.$1"; }
valid_num(){ case "$1" in ""|*[!0-9]*) return 1;; esac; }
load_config(){
 PT="$(get primary_table)"; ST="$(get secondary_table)"; TT="$(get tproxy_table)"
 BP="$(get primary_priority)"; PP="$(get secondary_priority)"; TP="$(get tproxy_priority)"
 for V in "$PT" "$ST" "$TT" "$BP" "$PP" "$TP"; do valid_num "$V" || return 1; done
 [ "$PT" != "$ST" ] && [ "$PT" != "$TT" ] && [ "$ST" != "$TT" ] || return 1
 [ "$BP" != "$PP" ] && [ "$BP" != "$TP" ] && [ "$PP" != "$TP" ] || return 1
}
snapshot(){
 : >"$STATE"
 "$IP" rule show | grep -E "^($BP|$PP|$TP):" >>"$STATE" || true
 for T in "$PT" "$ST" "$TT"; do
  echo "TABLE=$T" >>"$STATE"
  "$IP" route show table "$T" >>"$STATE" 2>/dev/null || true
 done
}
clear_managed(){
 for P in "$BP" "$PP" "$TP"; do "$IP" rule del priority "$P" 2>/dev/null || true; done
 for T in "$PT" "$ST" "$TT"; do "$IP" route flush table "$T" 2>/dev/null || true; done
}
verify_clear(){
 "$IP" rule show | grep -Eq "^($BP|$PP|$TP):" && return 1
 for T in "$PT" "$ST" "$TT"; do [ -z "$("$IP" route show table "$T" 2>/dev/null)" ] || return 1; done
}
restore_state(){
 clear_managed
 TABLE=
 while IFS= read -r LINE; do
  case "$LINE" in
   TABLE=*) TABLE="${LINE#TABLE=}" ;;
   [0-9]*:\ from\ all\ fwmark\ *)
    set -- $LINE
    "$IP" rule add priority "${1%:}" fwmark "$5" lookup "$7" || return 1
   ;;
   default\ via\ *)
    set -- $LINE
    [ "$2" = via ] && [ "$4" = dev ] || return 1
    if [ "$#" -eq 7 ] && [ "$6" = metric ]; then
     "$IP" route replace default via "$3" dev "$5" table "$TABLE" metric "$7" || return 1
    else
     [ "$#" -eq 5 ] || return 1
     "$IP" route replace default via "$3" dev "$5" table "$TABLE" || return 1
    fi
   ;;
   "local default dev lo scope host") "$IP" route replace local 0.0.0.0/0 dev lo table "$TABLE" || return 1 ;;
   "") ;;
   *) return 1 ;;
  esac
 done <"$STATE"
}
revert_applied(){
 "$UCI" -c "$CFG" set "mptcp_suite.routing.applied=$OLD" >/dev/null 2>&1 || true
 "$UCI" -c "$CFG" commit mptcp_suite >/dev/null 2>&1 || true
}
case "$MODE" in
 --dry-run) echo ROUTING_MANAGED_CLEAR_DRY_RUN; exit 0 ;;
 --apply) ;;
 *) echo ERROR=invalid_mode; exit 2 ;;
esac
[ "${MPTCP_ROUTING_CLEAR_APPLY:-0}" = 1 ] || { echo ERROR=apply_locked; exit 3; }
load_config || { echo ERROR=invalid_routing_state; exit 4; }
exec 9>"$LOCK"
"$FLOCK" -n 9 || { echo ERROR=lock_busy; exit 5; }
trap 'rm -f "$STATE"' EXIT INT TERM
snapshot || { echo ERROR=snapshot_failed; exit 6; }
OLD="$(get applied || true)"; [ -n "$OLD" ] || OLD=0
clear_managed
verify_clear || { restore_state || true; echo ERROR=clear_verify_failed; exit 7; }
"$UCI" -c "$CFG" set mptcp_suite.routing.applied=0 || { restore_state || true; echo ERROR=state_set_failed; exit 8; }
"$UCI" -c "$CFG" commit mptcp_suite || { revert_applied; restore_state || true; echo ERROR=state_commit_failed; exit 9; }
[ "$(get applied)" = 0 ] || { revert_applied; restore_state || true; echo ERROR=state_verify_failed; exit 10; }
echo ROUTING_MANAGED_CLEAR_OK
