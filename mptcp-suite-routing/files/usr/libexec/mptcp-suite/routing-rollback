#!/bin/sh
set -eu

MODE="${1:---dry-run}"
SNAP="${MPTCP_ROUTING_SNAPSHOT:-/tmp/mptcp-routing.snapshot}"
CFG="${MPTCP_ROUTING_CONFIG_DIR:-/etc/config}"
RESTORE="${MPTCP_ROUTING_RESTORE_BIN:-/usr/libexec/mptcp-suite/routing-restore}"
UCI="${MPTCP_ROUTING_UCI_BIN:-uci}"
FLOCK="${MPTCP_ROUTING_FLOCK_BIN:-flock}"
LOCK="${MPTCP_ROUTING_ROLLBACK_LOCK:-/tmp/mptcp-routing-rollback.lock}"
TRAFFIC_APPLY="${MPTCP_TRAFFIC_POLICY_APPLY:-/usr/sbin/traffic-policy-apply}"
LOGGER="${MPTCP_ROUTING_LOGGER_BIN:-logger}"
refresh_traffic_policy(){
 [ -x "$TRAFFIC_APPLY" ] || return 0
 [ "$("$UCI" -q get traffic_policy.main.enabled 2>/dev/null || true)" = 1 ] || return 0
 "$TRAFFIC_APPLY" >/dev/null 2>&1 || { "$LOGGER" -t mptcp-routing traffic_policy_refresh_failed 2>/dev/null || true; return 0; }
}


case "$MODE" in
 --dry-run)
  echo "ROUTING_ROLLBACK_DRY_RUN snapshot=$SNAP"
  exit 0
 ;;
 --apply) ;;
 *) echo ERROR=invalid_mode; exit 2 ;;
esac

[ -r "$SNAP" ] || { echo ERROR=snapshot_missing; exit 3; }
[ -x "$RESTORE" ] || { echo ERROR=restore_missing; exit 4; }

exec 9>"$LOCK"
"$FLOCK" -n 9 || { echo ERROR=lock_busy; exit 5; }

get(){ "$UCI" -c "$CFG" -q get "mptcp_suite.routing.$1"; }
PT="$(get primary_table)"
ST="$(get secondary_table)"
TT="$(get tproxy_table)"
BP="$(get primary_priority)"
PP="$(get secondary_priority)"
TP="$(get tproxy_priority)"

case "$PT:$ST:$TT:$BP:$PP:$TP" in
 *[!0-9:]*) echo ERROR=invalid_routing_state; exit 6 ;;
esac
[ "$PT" != "$ST" ] && [ "$PT" != "$TT" ] && [ "$ST" != "$TT" ] || { echo ERROR=duplicate_table; exit 6; }
[ "$BP" != "$PP" ] && [ "$BP" != "$TP" ] && [ "$PP" != "$TP" ] || { echo ERROR=duplicate_priority; exit 6; }

OLD="$(get applied || true)"
"$RESTORE" "$SNAP" "$PT" "$ST" "$TT" "$BP" "$PP" "$TP" || { echo ERROR=restore_failed; exit 7; }

state_revert(){
 if [ -n "$OLD" ]; then
  "$UCI" -c "$CFG" set "mptcp_suite.routing.applied=$OLD" >/dev/null 2>&1 || true
 else
  "$UCI" -c "$CFG" -q delete mptcp_suite.routing.applied >/dev/null 2>&1 || true
 fi
 "$UCI" -c "$CFG" commit mptcp_suite >/dev/null 2>&1 || true
}

"$UCI" -c "$CFG" set mptcp_suite.routing.applied=0 || { state_revert; echo ERROR=state_set_failed; exit 8; }
[ "$(get applied)" = 0 ] || { state_revert; echo ERROR=state_verify_failed; exit 9; }
"$UCI" -c "$CFG" commit mptcp_suite || { state_revert; echo ERROR=state_commit_failed; exit 10; }
[ "$(get applied)" = 0 ] || { state_revert; echo ERROR=state_commit_verify_failed; exit 11; }

refresh_traffic_policy
echo ROUTING_ROLLBACK_OK
