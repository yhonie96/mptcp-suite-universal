#!/bin/sh /etc/rc.common
START=99
STOP=88

wait_dns() {
 i=0
 while [ "$i" -lt 12 ]; do
  ss -lnt | grep -q '127.0.0.1:1053' &&
  nslookup google.com 127.0.0.1 >/dev/null 2>&1 &&
  return 0
  i=$((i+1))
  sleep 5
 done
 return 1
}

start() {
 wait_dns || {
  logger -t traffic-policy "DNS belum siap; penerapan dilewati"
  return 0
 }
 /usr/sbin/traffic-policy-apply
}

reload() {
 /usr/sbin/traffic-policy-apply
}

stop() {
 nft delete table ip traffic_policy 2>/dev/null || true
}
