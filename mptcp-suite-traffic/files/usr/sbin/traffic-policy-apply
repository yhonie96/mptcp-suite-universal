#!/bin/sh
set -e
. /lib/functions.sh

BASE="${MPTCP_TRAFFIC_POLICY_BASE:-/etc/traffic-policy}"
LOCK="${MPTCP_TRAFFIC_POLICY_LOCK:-/tmp/traffic-policy.apply.lock}"
STALE_DIR_LOCK="/tmp/traffic-policy.lock"
DNSMASQ_INIT="${MPTCP_TRAFFIC_POLICY_DNSMASQ_INIT:-/etc/init.d/dnsmasq}"
GEN_BIN="${MPTCP_TRAFFIC_POLICY_GENERATE:-/usr/sbin/traffic-policy-generate}"
VAL_BIN="${MPTCP_TRAFFIC_POLICY_VALIDATE:-/usr/sbin/traffic-policy-validate}"
R="$BASE/rollback"

[ -d "$STALE_DIR_LOCK" ] && rmdir "$STALE_DIR_LOCK" 2>/dev/null || true
exec 9>"$LOCK"
flock -n 9 || { echo APPLY_BUSY; exit 2; }
mkdir -p "$R"

cp -af /etc/config/dhcp "$R/dhcp"
nft list table ip traffic_policy >"$R/runtime.nft" 2>/dev/null || : >"$R/runtime.nft"

rollback(){
 cp -af "$R/dhcp" /etc/config/dhcp
 nft delete table ip traffic_policy 2>/dev/null || true
 [ ! -s "$R/runtime.nft" ] || nft -f "$R/runtime.nft"
 "$DNSMASQ_INIT" restart >/dev/null 2>&1 || true
 echo APPLY_ROLLBACK
 exit 1
}

wait_dns(){
 [ "${MPTCP_SKIP_DNS_WAIT:-0}" = 1 ] && return 0
 W=0
 while [ "$W" -lt 10 ]; do
  if pgrep -x dnsmasq >/dev/null 2>&1; then
   nslookup localhost 127.0.0.1 >/dev/null 2>&1 && return 0
   ss -lnu 2>/dev/null | grep -q ':53 ' && return 0
  fi
  W=$((W+1))
  sleep 1
 done
 return 1
}

"$VAL_BIN" || rollback
"$GEN_BIN" >/dev/null || rollback
sed 's/traffic_policy_test/traffic_policy/g' \
 /tmp/traffic-policy-test.nft >/tmp/traffic-policy-runtime.nft

{
 nft list table ip traffic_policy >/dev/null 2>&1 && echo 'delete table ip traffic_policy'
 cat /tmp/traffic-policy-runtime.nft
} >/tmp/traffic-policy-transaction.nft

nft -c -f /tmp/traffic-policy-transaction.nft || rollback

for S in $(uci show dhcp | awk -F'[.=]' \
 '$1=="dhcp" && $2 ~ /^traffic_manual_/ && $3=="ipset" {print $2}'); do
 uci -q delete "dhcp.$S"
done

N=0
add_domain(){ uci add_list "dhcp.traffic_manual_$N.domain=$1"; }
add_rule(){
 local S="$1" E T
 config_get E "$S" enabled 1
 config_get T "$S" target
 [ "$E:$T" = "1:wwan" ] || return 0
 N=$((N+1))
 uci set dhcp.traffic_manual_$N=ipset
 uci add_list dhcp.traffic_manual_$N.name=manual_$N
 uci set dhcp.traffic_manual_$N.table=traffic_policy
 uci set dhcp.traffic_manual_$N.table_family=ip
 uci set dhcp.traffic_manual_$N.family=4
 config_list_foreach "$S" domain add_domain
}

config_load traffic_policy
config_foreach add_rule rule
uci commit dhcp

nft -f /tmp/traffic-policy-transaction.nft || rollback
"$DNSMASQ_INIT" restart >/dev/null 2>&1 || rollback
wait_dns || rollback

echo "APPLY_OK rules=$N"
