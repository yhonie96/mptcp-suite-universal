#!/bin/sh
set -e
. /lib/functions.sh

LAN_DEV="$(uci -q get network.lan.device)"
MARK="$(uci -q get mptcp_suite.routing.policy_mark)"
[ -n "$LAN_DEV" ] && [ -n "$MARK" ] || { echo ERROR=missing_lan_or_mark; exit 1; }
OUT="${1:-/tmp/traffic-policy-test.nft}"
SETS="/tmp/traffic-policy-sets.$$"
RULES="/tmp/traffic-policy-rules.$$"
: >"$SETS"
: >"$RULES"
trap 'rm -f "$SETS" "$RULES"' EXIT

n=0
make_rule() {
 local s="$1" enabled target setname ips
 config_get enabled "$s" enabled 1
 config_get target "$s" target
 [ "$enabled" = 1 ] || return 0
 [ "$target" = wwan ] || return 0

 n=$((n+1))
 setname="manual_${n}"
 ips="$(uci -q get traffic_policy."$s".ipv4 | tr ' ' ',')"

 {
  echo " set $setname {"
  echo "  type ipv4_addr"
  echo "  flags interval"
  [ -z "$ips" ] || echo "  elements = { $ips }"
  echo " }"
 } >>"$SETS"

 echo "  iifname "$LAN_DEV" fib daddr type != local ip daddr @$setname counter meta mark set $MARK" >>"$RULES"
}

config_load traffic_policy
config_foreach make_rule rule

{
 echo 'table ip traffic_policy_test {'
 cat "$SETS"
 echo ' chain route_wwan {'
 echo '  type filter hook prerouting priority mangle - 2; policy accept;'
 cat "$RULES"
 echo ' }'
 echo '}'
} >"$OUT"

echo "GENERATE_VALID=$OUT"
